DATABASE_URL=postgresql://usuario:senha@localhost:5432/agenda_juri
SECRET_KEY=troque-esta-chave
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=sua-chave-secreta-do-cliente
# Chave Fernet estavel para criptografar tokens OAuth em repouso.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Em producao Vercel, use exatamente:
# https://agenda-juri-backend.vercel.app/api/auth/google/callback
# Em desenvolvimento, deixe em branco para o backend gerar a callback automaticamente.
GOOGLE_REDIRECT_URI=
# Opcional. Use apenas dominio Google Workspace, como empresa.com.
# Para contas Gmail individuais, use GOOGLE_ALLOWED_EMAILS. Nao use URLs aqui.
GOOGLE_ALLOWED_HOSTED_DOMAIN=
# Opcional. Use para restringir contas exatas, separadas por virgula.
GOOGLE_ALLOWED_EMAILS=
GOOGLE_DEFAULT_CARGO=
# Use "primary" para a agenda principal da conta conectada
# ou um ID como juridico@group.calendar.google.com para uma agenda compartilhada.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
GOOGLE_SYNC_PAST_DAYS=180
GOOGLE_CALENDAR_WEBHOOK_URL=https://agenda-juri-backend.vercel.app/api/integracoes/google/calendar/webhook
GOOGLE_WATCH_RENEWAL_HOURS=24
CORS_ALLOW_ALL_ORIGINS=false
# Configure a origem React exata em producao, com https.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Para frontend e backend HTTPS em origens distintas:
# SESSION_COOKIE_SAMESITE=None
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SAMESITE=None
# CSRF_COOKIE_SECURE=true

OPENAI_API_KEY=sua-chave-openai
AI_PROVIDER=openai
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
MEETINGS_MAX_AUDIO_SIZE_MB=25
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
