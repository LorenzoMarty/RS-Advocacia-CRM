# Host publico do app. Pode ser um dominio seu ou algo como:
# agenda-juri.<IP_PUBLICO>.sslip.io
DOMAIN=agenda-juri.example.com

# Django
SECRET_KEY=troque-por-uma-chave-com-50-caracteres-ou-mais
DEBUG=False
ALLOWED_HOSTS=agenda-juri.example.com
FRONTEND_URL=https://agenda-juri.example.com
CORS_ALLOWED_ORIGINS=https://agenda-juri.example.com
CSRF_TRUSTED_ORIGINS=https://agenda-juri.example.com
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Banco local na VM
POSTGRES_DB=agenda_juri
POSTGRES_USER=agenda_juri
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_SSL_REQUIRE=false

# Redis local na VM
REDIS_PASSWORD=troque-esta-senha
MEETINGS_PROCESSING_MODE=celery

# Google OAuth/Calendar/Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agenda-juri.example.com/api/auth/google/callback
GOOGLE_ALLOWED_HOSTED_DOMAIN=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_DEFAULT_CARGO=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
GOOGLE_SYNC_PAST_DAYS=180
GOOGLE_CALENDAR_WEBHOOK_URL=https://agenda-juri.example.com/api/integracoes/google/calendar/webhook
GOOGLE_WATCH_RENEWAL_HOURS=24
GOOGLE_DRIVE_ROOT_FOLDER_ID=
DRIVE_MAX_FILE_SIZE_MB=25

# IA. O hosting fica gratuito, mas chamadas OpenAI continuam sendo cobradas por uso.
OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
MEETINGS_MAX_AUDIO_SIZE_MB=25
MEETINGS_DELETE_AUDIO_AFTER_DOC=false

LOG_LEVEL=INFO
