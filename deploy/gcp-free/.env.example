# Dominio publico da API. Use o padrao sslip.io se nao tiver dominio proprio:
# api.<IP_PUBLICO>.sslip.io  (ex: api.34.56.78.90.sslip.io)
DOMAIN=api.SEU_IP_PUBLICO.sslip.io

# Django
SECRET_KEY=troque-por-uma-chave-com-50-caracteres-ou-mais
DEBUG=False
ALLOWED_HOSTS=api.SEU_IP_PUBLICO.sslip.io

# Postgres no Neon (cole a connection string pooled do painel Neon, sslmode=require)
DATABASE_URL=postgresql://user:senha@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL_REQUIRE=true

# Redis local na VM
REDIS_PASSWORD=troque-esta-senha
MEETINGS_PROCESSING_MODE=celery

# URLs do frontend (Cloudflare Pages). Ajuste apos criar o projeto la.
# Exemplo: https://agenda-juri.pages.dev
FRONTEND_URL=https://SEU_APP.pages.dev
CORS_ALLOWED_ORIGINS=https://SEU_APP.pages.dev
CSRF_TRUSTED_ORIGINS=https://SEU_APP.pages.dev,https://api.SEU_IP_PUBLICO.sslip.io

# Cookies cross-site (obrigatorio: SPA no pages.dev, API no sslip.io = origens diferentes)
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SAMESITE=None
CSRF_COOKIE_SECURE=true

# HTTPS e seguranca
SECURE_SSL_REDIRECT=true
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# Google OAuth/Calendar/Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI deve ser exatamente este (cadastrar no Google Cloud Console):
GOOGLE_REDIRECT_URI=https://api.SEU_IP_PUBLICO.sslip.io/api/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_ALLOWED_HOSTED_DOMAIN=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_DEFAULT_CARGO=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
GOOGLE_SYNC_PAST_DAYS=180
GOOGLE_CALENDAR_WEBHOOK_URL=https://api.SEU_IP_PUBLICO.sslip.io/api/integracoes/google/calendar/webhook
GOOGLE_WATCH_RENEWAL_HOURS=24
GOOGLE_DRIVE_ROOT_FOLDER_ID=1NQiYxTO3pPBEcety2ES-K_YLFIoYK5oT
DRIVE_MAX_FILE_SIZE_MB=25

# IA — o hosting e gratis, mas as chamadas OpenAI sao cobradas por uso
OPENAI_API_KEY=
AI_PROVIDER=openai
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
MEETINGS_MAX_AUDIO_SIZE_MB=25
MEETINGS_DELETE_AUDIO_AFTER_DOC=false

LOG_LEVEL=INFO
