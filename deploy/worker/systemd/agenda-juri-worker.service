# Alternative to Docker Compose: run the Celery worker directly under systemd.
# Assumes the repo is cloned at /opt/agenda-juri with a venv in backend/.venv
# and Redis installed via the distro package (configure TLS/requirepass in
# /etc/redis/redis.conf to mirror deploy/worker/docker-compose.yml).
#
# Install:
#   sudo cp agenda-juri-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now agenda-juri-worker

[Unit]
Description=Agenda-Juri Celery worker (gravacoes de reunioes)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=agenda-juri
WorkingDirectory=/opt/agenda-juri/Agenda-Juri/backend
EnvironmentFile=/etc/agenda-juri/worker.env
ExecStart=/opt/agenda-juri/Agenda-Juri/backend/.venv/bin/celery \
    -A jurisagenda worker --loglevel=info --concurrency=2
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
