# Worker environment (copy to .env and fill in the production values).
# These mirror the Vercel backend env vars — the worker reads/writes the same
# Postgres and refreshes the same encrypted Google tokens.

# Postgres (same database the Vercel backend uses)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Django
SECRET_KEY=
DEBUG=false

# Redis broker password (also referenced by docker-compose for the redis service).
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=

# OpenAI (transcription + summary)
OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# OPENAI_SUMMARY_MODEL=gpt-4.1-mini
# MEETINGS_MAX_AUDIO_SIZE_MB=25

# Google OAuth/Drive (token refresh happens inside the worker)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
