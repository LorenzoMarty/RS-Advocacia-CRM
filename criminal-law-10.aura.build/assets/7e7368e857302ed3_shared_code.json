rounded-full pointer-events-none opacity-40 mix-blend-screen\"></div>\n        \n        <div class=\"max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10\">\n            <!-- Text Content -->\n            <div class=\"text-left\">\n                <!-- Badge -->\n                <div class=\"reveal delay-100 inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#D4AF37]/20 bg-[#D4AF37]/5 text-xs font-medium text-[#D4AF37] mb-8 shadow-[0_0_15px_-5px_rgba(212,175,55,0.3)]\">\n                    <span class=\"relative flex h-1.5 w-1.5\">\n                        <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[#D4AF37] opacity-75\"></span>\n                        <span class=\"relative inline-flex rounded-full h-1.5 w-1.5 bg-[#D4AF37]\"></span>\n                    </span>\n                    Advocacia Criminal Especializada\n                </div>\n\n                <!-- Title -->\n                <h1 class=\"reveal delay-200 text-5xl md:text-6xl lg:text-7xl font-serif tracking-tight text-white mb-6 leading-[1.1]\">\n                    Defesa Criminal <br>\n                    <span class=\"italic text-gold-gradient\">Estratégica</span> &amp; <br>\n                    Humanizada.\n                </h1>\n\n                <!-- Subtitle -->\n                <p class=\"reveal delay-300 text-lg text-slate-400 max-w-xl mb-10 font-light leading-relaxed\">\n                    Assessoria jurídica completa para pessoas físicas e empresas. Protegendo sua liberdade dentro dos limites legais e garantias do direito penal.\n                </p>\n\n                <!-- Buttons -->\n                <div class=\"reveal delay-300 flex flex-col sm:flex-row items-center gap-4\">\n                    <a href=\"https://wa.me/5511985272009\" class=\"w-full sm:w-auto px-8 py-3.5 bg-white text-black text-xs font-semibold rounded hover:bg-slate-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.1)] text-center flex items-center justify-center gap-2\">\n                        Falar com Especialista\n                        <span class=\"iconify group-hover:translate-x-0.5 transition-transform\" data-icon=\"lucide:arrow-right\" data-width=\"14\" data-height=\"14\"></span>\n                    </a>\n                    <a href=\"#quem-somos\" class=\"w-full sm:w-auto px-8 py-3.5 border border-white/10 text-white text-xs font-medium rounded hover:bg-white/5 hover:border-white/20 transition-all text-center flex items-center justify-center\">\n                        Conheça o Escritório\n                    </a>\n                </div>\n            </div>\n\n            <!-- Hero Image -->\n            <div class=\"reveal delay-200 relative h-[500px] w-full rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-slate-900/10 backdrop-blur-sm\">\n                <div class=\"absolute inset-0 z-10 bg-slate-950/20 mix-blend-overlay\"></div>\n                <img src=\"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/dbd259d7-f117-4f0e-9348-1f50f0cb96fe_3840w.png\" alt=\"Advogado Criminalista\" class=\"w-full h-full object-cover opacity-90 hover:scale-105 transition-transform duration-1000\">\n                <div class=\"absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-80\"></div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Media Carousel (Formerly Logo Carousel) -->\n    <section id=\"midia\" class=\"border-y border-white/[0.06] bg-white/[0.01] py-10 relative overflow-hidden reveal\">\n        <div class=\"max-w-7xl mx-auto px-6 mb-8 text-center\">\n            <p class=\"text-xs font-medium text-slate-500 uppercase tracking-widest\">D. Ribeiro na Mídia e Imprensa</p>\n        </div>\n        <div class=\"mask-linear w-full inline-flex flex-nowrap overflow-hidden\">\n            <div class=\"flex items-center justify-center md:justify-start [&_li]:mx-8 animate-scroll w-max\">\n                <!-- Set 1 -->\n                <div class=\"flex items-center gap-16 md:gap-24 px-8 opacity-60 hover:opacity-100 transition-all duration-500\">\n                    <span class=\"flex items-center gap-2 text-lg font-serif font-semibold text-white\"><span class=\"iconify\" data-icon=\"lucide:tv\"></span> Televisão</span>\n                    <span class=\"flex items-center gap-2 text-lg font-serif font-semibold text-white\"><span class=\"iconify\" data-icon=\"lucide:radio\"></span> Rádio</span>\n                    <span class=\"flex items-center gap-2 text-lg font-serif font-semibold text-white\"><span class=\"iconify\" data-icon=\"lucide:newspaper\"></span> Jornais</span>\n                    <span class=\"flex items-center gap-2 text-lg font-serif font-semibold text-white\"><span class=\"iconify\" data-icon=\"lucide:mic\"></span> Podcasts</span>\n                    <span class=\"flex items-center gap-2 text-lg font-serif font-semibold text-white\"><span class=\"iconify\" data-icon=\"lucide:globe\"></span> Portais Jurídicos</span>\n                </div>\n                <!-- Set 2 (Duplicate) -->\n                <div class=\"flex items-center gap-16 md:gap-24 px-8 opacity-60 hover:opacity-100 transition-all duration-500\">\n                    <span class=\"flex items-center gap-2 text-lg font-serif font-semibold text-white\"><span class=\"iconify\" data-icon=\"lucide:tv\"></span> Televisão</span>\n                    <span class=\"flex items-center gap-2 text-lg font-serif font-semibold text-white\"><span class=\"iconify\" data-icon=\"lucide:radio\"></span> Rádio</span>\n                    <span class=\"flex items-center gap-2 text-lg font-serif font-semibold text-white\"><span class=\"iconify\" data-icon=\"lucide:newspaper\"></span> Jornais</span>\n                    <span class=\"flex items-center gap-2 text-lg font-serif font-semibold text-white\"><span class=\"iconify\" data-icon=\"lucide:mic\"></span> Podcasts</span>\n                    <span class=\"flex items-center gap-2 text-lg font-serif font-semibold text-white\"><span class=\"iconify\" data-icon=\"lucide:globe\"></span> Portais Jurídicos</span>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Metrics Section (Authority) -->\n    <section class=\"py-24 border-b border-white/[0.06]\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-12 text-center md:text-left\">\n                <div class=\"reveal delay-100\">\n                    <div class=\"flex items-baseline justify-center md:justify-start gap-0.5 text-3xl md:text-4xl font-serif text-white tracking-tight mb-2\">\n                        <span class=\"counter\" data-target=\"8\">0</span> Anos\n                    </div>\n                    <div class=\"text-xs text-slate-500 uppercase tracking-widest\">Experiência Militar</div>\n                </div>\n                <div class=\"reveal delay-200\">\n                    <div class=\"flex items-baseline justify-center md:justify-start gap-0.5 text-3xl md:text-4xl font-serif text-white tracking-tight mb-2\">\n                        <span class=\"counter\" data-target=\"300\">0</span>+\n                    </div>\n                    <div class=\"text-xs text-slate-500 uppercase tracking-widest\">Artigos Publicados</div>\n                </div>\n                <div class=\"reveal delay-300\">\n                    <div class=\"flex items-baseline justify-center md:justify-start gap-0.5 text-3xl md:text-4xl font-serif text-white tracking-tight mb-2\">\n                        <span class=\"counter\" data-target=\"24\">0</span>h\n                    </div>\n                    <div class=\"text-xs text-slate-500 uppercase tracking-widest\">Plantão Ativo</div>\n                </div>\n                <div class=\"reveal delay-300\">\n                    <div class=\"flex items-baseline justify-center md:justify-start gap-0.5 text-3xl md:text-4xl font-serif text-white tracking-tight mb-2\">\n                        <span class=\"counter\" data-target=\"100\">0</span>%\n                    </div>\n                    <div class=\"text-xs text-slate-500 uppercase tracking-widest\">Confidencialidade</div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Bio & Credentials (Adapted from Testimonials/Results) -->\n    <section id=\"quem-somos\" class=\"py-24 border-t border-white/[0.06] bg-gradient-to-b from-white/[0.01] to-transparent\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12\">\n                <!-- Bio Text -->\n                <div class=\"lg:col-span-5 reveal\">\n                    <h2 class=\"font-serif text-3xl md:text-4xl text-white mb-6 tracking-tight\">\n                        Liderado pelo <br>\n                        <span class=\"text-[#D4AF37]\">Dr. Douglas Ribeiro</span>\n                    </h2>\n                    <p class=\"text-slate-400 leading-relaxed mb-8 font-light text-lg\">\n                        Advogado criminal militante desde 2016, Gestor Jurídico e Sócio-fundador. Com uma mentalidade visionária, combina técnica jurídica refinada com gestão de alto nível.\n                    </p>\n                    <div class=\"h-px w-24 bg-[#D4AF37] mb-6 shadow-[0_0_10px_#D4AF37]\"></div>\n                    <p class=\"text-xs font-semibold text-slate-500 uppercase tracking-widest\">OAB/SP: 32.871</p>\n                </div>\n\n                <!-- Credential Cards -->\n                <div class=\"lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-6\">\n                    <!-- Credential 1 -->\n                    <div class=\"reveal delay-100 p-8 rounded-xl bg-[#0B0C10] border border-white/[0.08] hover:border-[#D4AF37]/30 transition-colors relative overflow-hidden group\">\n                        <div class=\"absolute -right-10 -top-10 w-40 h-40 bg-[#D4AF37]/5 blur-[50px] group-hover:bg-[#D4AF37]/10 transition-all duration-700 rounded-full\"></div>\n                        <div class=\"relative z-10\">\n                            <div class=\"h-10 w-10 rounded-full bg-[#D4AF37]/10 flex items-center justify-center text-[#D4AF37] mb-6 border border-[#D4AF37]/20\">\n                                <span class=\"iconify\" data-icon=\"lucide:graduation-cap\" data-width=\"20\"></span>\n                            </div>\n                            <h3 class=\"text-white font-serif font-medium mb-2\">MBA em Gestão</h3>\n                            <p class=\"text-sm text-slate-400 font-light\">Pela FGV – SP (2024). Visão estratégica aplicada ao direito.</p>\n                        </div>\n                    </div>\n                    \n                    <!-- Credential 2 -->\n                    <div class=\"reveal delay-200 p-8 rounded-xl bg-[#0B0C10] border border-white/[0.08] hover:border-[#D4AF37]/30 transition-colors relative overflow-hidden group\">\n                        <div class=\"absolute -right-10 -top-10 w-40 h-40 bg-[#D4AF37]/5 blur-[50px] group-hover:bg-[#D4AF37]/10 transition-all duration-700 rounded-full\"></div>\n                        <div class=\"relative z-10\">\n                            <div class=\"h-10 w-10 rounded-full bg-[#D4AF37]/10 flex items-center justify-center text-[#D4AF37] mb-6 border border-[#D4AF37]/20\">\n                                <span class=\"iconify\" data-icon=\"lucide:scale\" data-width=\"20\"></span>\n                            </div>\n                            <h3 class=\"text-white font-serif font-medium mb-2\">Especialista Penal</h3>\n                            <p class=\"text-sm text-slate-400 font-light\">Pós-graduado em Direito Penal, Processo Penal e Administrativo.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Philosophy Section (Adapted from Services) -->\n    <section id=\"filosofia\" class=\"py-32 relative\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"mb-20 md:mb-28 reveal\">\n                <span class=\"text-[#D4AF37] text-xs font-semibold tracking-widest uppercase mb-2 block\">Nossa Filosofia</span>\n                <h2 class=\"text-3xl md:text-4xl font-serif text-white tracking-tight mb-4\">Pilares da Sociedade</h2>\n                <p class=\"text-slate-400 max-w-xl text-lg font-light\">Fundamentos que norteiam nossa atuação na defesa dos seus direitos.</p>\n            </div>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                <!-- Card 1: Missão -->\n                <div class=\"reveal delay-100 group relative p-8 rounded-2xl bg-white/[0.02] hover:bg-white/[0.04] border border-white/10 hover:border-[#D4AF37]/30 transition-all duration-500 overflow-hidden\">\n                    <div class=\"absolute inset-0 bg-gradient-to-b from-[#D4AF37]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500\"></div>\n                    <div class=\"relative z-10\">\n                        <div class=\"h-10 w-10 rounded-lg bg-[#D4AF37]/10 flex items-center justify-center mb-6 text-[#D4AF37] border border-[#D4AF37]/20 shadow-[0_0_15px_-5px_rgba(212,175,55,0.5)]\">\n                            <span class=\"iconify\" data-icon=\"lucide:target\" data-width=\"20\"></span>\n                        </div>\n                        <h3 class=\"text-xl font-serif text-white tracking-tight mb-3\">Missão</h3>\n                        <p class=\"text-sm text-slate-400 leading-relaxed mb-6\">\n                            Defender e representar juridicamente quem é vítima ou acusado em processos penais, com atuação consultiva, estratégica e humanizada.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Card 2: Visão -->\n                <div class=\"reveal delay-200 group relative p-8 rounded-2xl bg-white/[0.02] hover:bg-white/[0.04] border border-white/10 hover:border-[#D4AF37]/30 transition-all duration-500 overflow-hidden\">\n                    <div class=\"absolute inset-0 bg-gradient-to-b from-[#D4AF37]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500\"></div>\n                    <div class=\"relative z-10\">\n                        <div class=\"h-10 w-10 rounded-lg bg-[#D4AF37]/10 flex items-center justify-center mb-6 text-[#D4AF37] border border-[#D4AF37]/20 shadow-[0_0_15px_-5px_rgba(212,175,55,0.5)]\">\n                            <span class=\"iconify\" data-icon=\"lucide:eye\" data-width=\"20\"></span>\n                        </div>\n                        <h3 class=\"text-xl font-serif text-white tracking-tight mb-3\">Visão</h3>\n                        <p class=\"text-sm text-slate-400 leading-relaxed mb-6\">\n                            Ser referência no direito criminal em SP até 2030. Empreender de modo disruptivo e inovador na advocacia.\n                        </p>\n                    </div>\n                </div>\n\n                <!-- Card 3: Valores -->\n                <div class=\"reveal delay-300 group relative p-8 rounded-2xl bg-white/[0.02] hover:bg-white/[0.04] border border-white/10 hover:border-[#D4AF37]/30 transition-all duration-500 overflow-hidden\">\n                    <div class=\"absolute inset-0 bg-gradient-to-b from-[#D4AF37]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500\"></div>\n                    <div class=\"relative z-10\">\n                        <div class=\"h-10 w-10 rounded-lg bg-[#D4AF37]/10 flex items-center justify-center mb-6 text-[#D4AF37] border border-[#D4AF37]/20 shadow-[0_0_15px_-5px_rgba(212,175,55,0.5)]\">\n                            <span class=\"iconify\" data-icon=\"lucide:diamond\" data-width=\"20\"></span>\n                        </div>\n                        <h3 class=\"text-xl font-serif text-white tracking-tight mb-3\">Valores</h3>\n                        <p class=\"text-sm text-slate-400 leading-relaxed mb-6\">\n                            Trabalhar de forma ética, transparente, honesta e primar pela qualidade técnica e excelência no atendimento.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section id=\"contato\" class=\"py-24 md:py-32 relative overflow-hidden border-t border-white/[0.06]\">\n        <div class=\"max-w-5xl mx-auto px-6 relative z-10\">\n            <div class=\"text-center mb-16 reveal\">\n                <h2 class=\"text-3xl md:text-5xl font-serif text-white tracking-tight mb-6\">Atendimento com <span class=\"italic text-[#D4AF37]\">Sigilo</span></h2>\n                <p class=\"text-slate-400 text-lg font-light\">Agende sua consulta em ambiente privado. Sua liberdade é nossa prioridade.</p>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12\">\n                <!-- Form -->\n                <form class=\"reveal delay-100 space-y-6 bg-[#0E0F14]/50 backdrop-blur-sm p-8 md:p-12 rounded-2xl border border-white/[0.08] shadow-2xl relative\">\n                    <div class=\"absolute inset-0 bg-gradient-to-tr from-[#D4AF37]/5 via-transparent to-transparent pointer-events-none rounded-2xl\"></div>\n                    \n                    <div class=\"space-y-2 relative z-10\">\n                        <label class=\"text-[10px] font-semibold text-slate-500 uppercase tracking-widest\">Nome Completo</label>\n                        <input type=\"text\" class=\"w-full bg-[#0B0C10] border border-white/10 rounded px-4 py-3 text-sm text-white focus:outline-none focus:border-[#D4AF37]/50 transition-colors\" placeholder=\"Seu nome\">\n                    </div>\n                    \n                    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-6 relative z-10\">\n                         <div class=\"space-y-2\">\n                            <label class=\"text-[10px] font-semibold text-slate-500 uppercase tracking-widest\">Email</label>\n                            <input type=\"email\" class=\"w-full bg-[#0B0C10] border border-white/10 rounded px-4 py-3 text-sm text-white focus:outline-none focus:border-[#D4AF37]/50 transition-colors\" placeholder=\"seu@email.com\">\n                        </div>\n                        <div class=\"space-y-2\">\n                            <label class=\"text-[10px] font-semibold text-slate-500 uppercase tracking-widest\">Telefone</label>\n                            <input type=\"tel\" class=\"w-full bg-[#0B0C10] border border-white/10 rounded px-4 py-3 text-sm text-white focus:outline-none focus:border-[#D4AF37]/50 transition-colors\" placeholder=\"(11) 99999-9999\">\n                        </div>\n                    </div>\n\n                    <div class=\"space-y-2 relative z-10\">\n                        <label class=\"text-[10px] font-semibold text-slate-500 uppercase tracking-widest\">Mensagem (Opcional)</label>\n                        <textarea rows=\"4\" class=\"w-full bg-[#0B0C10] border border-white/10 rounded px-4 py-3 text-sm text-white focus:outline-none focus:border-[#D4AF37]/50 transition-colors resize-none\" placeholder=\"Breve relato do caso...\"></textarea>\n                    </div>\n\n                    <div class=\"pt-4 relative z-10\">\n                        <button type=\"button\" class=\"w-full bg-gradient-to-b from-[#D4AF37] to-[#b5952f] hover:from-[#b5952f] hover:to-[#967d29] text-black font-semibold py-3.5 rounded text-sm transition-all shadow-[0_0_20px_rgba(212,175,55,0.2)] hover:shadow-[0_0_30px_rgba(212,175,55,0.4)]\">\n                            Agendar Atendimento\n                        </button>\n                    </div>\n                </form>\n\n                <!-- Contact Details -->\n                <div class=\"reveal delay-200 flex flex-col justify-center space-y-8\">\n                    <div class=\"flex items-start gap-4\">\n                        <div class=\"mt-1 p-2 rounded-md bg-[#D4AF37]/10 border border-[#D4AF37]/20 text-[#D4AF37]\">\n                            <span class=\"iconify\" data-icon=\"lucide:map-pin\" data-width=\"20\"></span>\n                        </div>\n                        <div>\n                            <h4 class=\"text-white font-medium mb-1\">Escritório</h4>\n                            <p class=\"text-slate-400 text-sm leading-relaxed\">\n                                Rua Potiguares, 308, Sobreloja,<br>\n                                Tatuapé, São Paulo/SP<br>\n                                CEP: 03065-010\n                            </p>\n                        </div>\n                    </div>\n\n                    <div class=\"flex items-center gap-4\">\n                         <div class=\"p-2 rounded-md bg-[#D4AF37]/10 border border-[#D4AF37]/20 text-[#D4AF37]\">\n                            <span class=\"iconify\" data-icon=\"lucide:phone\" data-width=\"20\"></span>\n                        </div>\n                        <div>\n                            <h4 class=\"text-white font-medium mb-1\">Telefone</h4>\n                            <p class=\"text-slate-400 text-sm\">(11) 2051-8910</p>\n                        </div>\n                    </div>\n\n                    <div class=\"flex items-center gap-4\">\n                         <div class=\"p-2 rounded-md bg-[#D4AF37]/10 border border-[#D4AF37]/20 text-[#D4AF37]\">\n                            <span class=\"iconify\" data-icon=\"lucide:mail\" data-width=\"20\"></span>\n                        </div>\n                        <div>\n                            <h4 class=\"text-white font-medium mb-1\">Email</h4>\n                            <p class=\"text-slate-400 text-sm\">d.ribeiro@dribeirosociedade.com.br</p>\n                        </div>\n                    </div>\n                    \n                    <div class=\"pt-8 border-t border-white/5\">\n                        <p class=\"text-slate-500 text-xs mb-2\">Horário de Atendimento:</p>\n                        <p class=\"text-slate-300 text-sm\">Segunda a Sexta: 08:00 - 18:00</p>\n                        <p class=\"text-[#D4AF37] text-sm mt-1 font-medium\">Plantão 24h para flagrantes</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"border-t border-white/[0.06] bg-[#0B0C10] pt-20 pb-10\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"grid grid-cols-1 md:grid-cols-4 gap-12 mb-20\">\n                <div class=\"col-span-1 md:col-span-2\">\n                    <div class=\"flex items-center gap-2 mb-6\">\n                         <span class=\"font-serif text-xl font-bold tracking-tight text-white\">D. RIBEIRO</span>\n                    </div>\n                    <p class=\"text-sm text-slate-500 max-w-xs leading-relaxed font-light\">\n                        Excelência técnica e comprometimento na defesa dos seus direitos. Advocacia criminal com foco em resultados.\n                    </p>\n                </div>\n                <div>\n                    <h4 class=\"text-white text-xs font-semibold uppercase tracking-widest mb-6\">Navegação</h4>\n                    <ul class=\"space-y-4 text-sm text-slate-500\">\n                        <li><a href=\"#inicio\" class=\"hover:text-[#D4AF37] transition-colors\">Início</a></li>\n                        <li><a href=\"#quem-somos\" class=\"hover:text-[#D4AF37] transition-colors\">Quem Somos</a></li>\n                        <li><a href=\"#filosofia\" class=\"hover:text-[#D4AF37] transition-colors\">Atuação</a></li>\n                        <li><a href=\"#midia\" class=\"hover:text-[#D4AF37] transition-colors\">Na Mídia</a></li>\n                    </ul>\n                </div>\n                <div>\n                    <h4 class=\"text-white text-xs font-semibold uppercase tracking-widest mb-6\">Legal</h4>\n                    <ul class=\"space-y-4 text-sm text-slate-500\">\n                        <li>CNPJ: 38.660.175/0001-06</li>\n                        <li>OAB/SP: 32.871</li>\n                        <li><a href=\"#\" class=\"hover:text-[#D4AF37] transition-colors\">Termos de Uso</a></li>\n                        <li><a href=\"#\" class=\"hover:text-[#D4AF37] transition-colors\">Privacidade</a></li>\n                    </ul>\n                </div>\n            </div>\n            \n            <div class=\"border-t border-white/[0.06] pt-8 flex flex-col md:flex-row items-center justify-between gap-4\">\n                <p class=\"text-xs text-slate-600\">© 2024 D. Ribeiro Sociedade de Advocacia. Todos os direitos reservados.</p>\n                <div class=\"flex gap-6\">\n                    <a href=\"#\" class=\"text-slate-600 hover:text-white transition-colors\">\n                        <span class=\"iconify\" data-icon=\"lucide:instagram\" data-width=\"18\" data-height=\"18\"></span>\n                    </a>\n                    <a href=\"#\" class=\"text-slate-600 hover:text-white transition-colors\">\n                        <span class=\"iconify\" data-icon=\"lucide:linkedin\" data-width=\"18\" data-height=\"18\"></span>\n                    </a>\n                    <a href=\"#\" class=\"text-slate-600 hover:text-white transition-colors\">\n                        <span class=\"iconify\" data-icon=\"lucide:facebook\" data-width=\"18\" data-height=\"18\"></span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Scroll Reveal Animation Logic (From Template)\n        document.addEventListener('DOMContentLoaded', () => {\n            const reveals = document.querySelectorAll('.reveal');\n            const revealOnScroll = () => {\n                const windowHeight = window.innerHeight;\n                const elementVisible = 100;\n                reveals.forEach((reveal) => {\n                    const elementTop = reveal.getBoundingClientRect().top;\n                    if (elementTop < windowHeight - elementVisible) {\n                        reveal.classList.add('active');\n                    }\n                });\n            };\n            window.addEventListener('scroll', revealOnScroll);\n            revealOnScroll();\n\n            // Number Counter Logic (From Template)\n            const counters = document.querySelectorAll('.counter');\n            let hasAnimated = false;\n            \n            const animateCounters = () => {\n                counters.forEach(counter => {\n                    const target = parseFloat(counter.getAttribute('data-target'));\n                    const isFloat = target % 1 !== 0;\n                    const duration = 2000;\n                    const increment = target / (duration / 16);\n                    let current = 0;\n                    \n                    const updateCount = () => {\n                        current += increment;\n                        if (current < target) {\n                            counter.innerText = isFloat ? current.toFixed(1) : Math.ceil(current);\n                            requestAnimationFrame(updateCount);\n                        } else {\n                            counter.innerText = target;\n                        }\n                    };\n                    updateCount();\n                });\n            };\n\n            // Intersection Observer for Metrics\n            const metricsSection = document.querySelector('.counter')?.closest('section');\n            if(metricsSection) {\n                const observer = new IntersectionObserver((entries) => {\n                    entries.forEach(entry => {\n                        if (entry.isIntersecting && !hasAnimated) {\n                            animateCounters();\n                            hasAnimated = true;\n                        }\n                    });\n                }, { threshold: 0.5 });\n                observer.observe(metricsSection);\n            }\n        });\n    </script>\n</body>\n</html>","language":"html","username":"91e47ccc-61ec-48b1-9d07-d904a16a4937","created_at":"2025-12-31T12:54:46.759542+00:00","views":246,"image_url":"https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/preview-images/shared-code-previews/criminal-law-10-preview-1767615369871.jpeg","forks":6,"private":false,"watermark":true,"featured":true,"share_source_code":true,"user_id":"91e47ccc-61ec-48b1-9d07-d904a16a4937","category":"Web","updated_at":null,"tags":["Landing Page","Services","Brand","Dark","Clean","Minimal","Large Type","Law Firm","Legal"],"description":"Sophisticated dark-themed criminal law firm landing page template for advocacy offices to present expertise, media presence, and secure consultations.","premium":false,"price":null,"purchase_url":null,"long_description":"**Criminal Law Firm Landing Page Template**\n\nA premium, dark-themed landing page template crafted for criminal law offices and solo attorneys who need a credible, media-ready digital presence.\n\n## Key Features\n- **Hero section** with urgent 24h plantão CTA and WhatsApp contact\n- **Attorney bio & credentials grid** highlighting expertise, education, and leadership roles\n- **Mission, vision, values** section to convey positioning and ethics\n- **Media & social proof** area for TV, radio, newspaper, and podcast appearances\n- **Contact-focused footer** with address, phone, email, and confidential consultation CTA\n\n## Primary Use Case\nIdeal for criminal defense firms looking to quickly launch a high-conversion, trust-building landing page that showcases authority, philosophy, and clear ways to get in touch.","custom_domain":null,"favicon_light_url":null,"favicon_dark_url":null,"dns_verified":null,"dns_verified_at":null,"dns_a_record":null,"netlify_apex_exists":null,"netlify_www_exists":null,"netlify_verified_at":null,"custom_domain_added_at":null,"netlify_site_id":null,"umami_website_id":null,"umami_share_id":null,"analytics_enabled":false,"gtm_container_id":null,"remix_source":{},"credit_remix_source":false,"search_visibility":"aura_and_custom_domain"}]