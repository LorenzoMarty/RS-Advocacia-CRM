hite/20 rounded-full\"></div>\n                                    <span class=\"text-[10px] text-white/30 uppercase\">Sentença</span>\n                                </div>\n                            </div>\n\n                            <!-- Stat Cards -->\n                            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 relative z-10\">\n                                <div class=\"glass-panel p-5 rounded-lg border-brand-border/50\">\n                                    <div class=\"flex items-start justify-between mb-4\">\n                                        <div class=\"p-2 rounded-md bg-white/5 text-white/70\">\n                                            <span class=\"iconify\" data-icon=\"lucide:clock\" data-width=\"18\"></span>\n                                        </div>\n                                        <span class=\"text-xs font-mono text-brand-gold bg-brand-gold/10 px-1.5 py-0.5 rounded\">URGENTE</span>\n                                    </div>\n                                    <div class=\"text-2xl font-medium text-white mb-1\">24/7</div>\n                                    <div class=\"text-xs text-white/40\">Atuação em Flagrantes</div>\n                                </div>\n\n                                <div class=\"glass-panel p-5 rounded-lg border-brand-border/50\">\n                                    <div class=\"flex items-start justify-between mb-4\">\n                                        <div class=\"p-2 rounded-md bg-white/5 text-white/70\">\n                                            <span class=\"iconify\" data-icon=\"lucide:shield-check\" data-width=\"18\"></span>\n                                        </div>\n                                    </div>\n                                    <div class=\"text-2xl font-medium text-white mb-1\">100%</div>\n                                    <div class=\"text-xs text-white/40\">Sigilo Absoluto</div>\n                                </div>\n\n    