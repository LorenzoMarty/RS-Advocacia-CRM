class=\"text-red-400\">ALERT</span> Mandado de Busca\n                            </div>\n                            <div class=\"flex items-center gap-2 text-[10px] text-white/60 font-mono\">\n                                <span class=\"text-brand-gold\">ACTION</span> Presença Advogado\n                            </div>\n                            <div class=\"flex items-center gap-2 text-[10px] text-white/60 font-mono\">\n                                <span class=\"text-brand-gold\">SUCCESS</span> Depoimento Adiado\n                            </div>\n                            <div class=\"w-full h-1 bg-white/5 rounded-full mt-1\"></div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Card 3: Jury -->\n                <div class=\"md:col-span-1 rounded-3xl bg-[#0C0C0C] border border-white/10 p-8 relative overflow-hidden group reveal delay-100\">\n                    <div class=\"absolute -bottom-10 -right-10 w-40 h-40 bg-brand-gold/10 blur-[60px] rounded-full\"></div>\n                    <div class=\"w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center mb-6 text-white\">\n                        <span class=\"iconify\" data-icon=\"lucide:users\" data-width=\"20\"></span>\n                    </div>\n                    <h3 class=\"text-xl font-medium text-white mb-2\">Tribunal do Júri</h3>\n                    <p class=\"text-white/50 text-sm font-light mb-8\">\n                        Defesa plena em plenário. Oratória combativa e preparação técnica para casos de crimes contra a vida.\n                    </p>\n                    <div class=\"relative h-24\">\n                         <div class=\"absolute inset-0 flex items-center justify-center\">\n                            <div class=\"w-full bg-white/5 rounded-xl p-4 border border-white/5 flex items-center justify-between\">\n                                <div class=\"flex items-center gap-3\">\n                                    <span class=\"w-2 h-2 rounded-full bg-green-500 animate-pulse\"></span>\n                                    <span class=\"text-xs text-white/80 font-medium\">Tese Defensiva</span>\n                                </div>\n                                <span class=\"text-xs text-white/40\">Absolvição</span>\n                            </div>\n                         </div>\n                    </div>\n                </div>\n\n                <!-- Card 4: Compliance -->\n                <div class=\"md:col-span-2 rounded-3xl bg-[#0C0C0C] border border-white/10 p-8 md:p-10 relative overflow-hidden group reveal\">\n                    <div class=\"flex flex-col md:flex-row justify-between items-end gap-8 h-full\">\n                        <div class=\"max-w-xs\">\n                            <div class=\"w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center mb-6 text-white/80\">\n                                <span class=\"iconify\" data-icon=\"lucide:scale\" data-width=\"20\"></span>\n                            </div>\n                            <h3 class=\"text-2xl font-medium text-white mb-3\">Consultoria Preventiva</h3>\n                            <p class=\"text-white/50 text-sm font-light leading-relaxed\">\n                                Análise de riscos penais para empresas e executivos. Compliance criminal e defesa em crimes tributários e financeiros.\n                            </p>\n                        </div>\n                        \n                        <!-- Document Mockup -->\n                        <div class=\"w-full md:w-[320px] bg-[#020202] border border-white/10 rounded-xl p-4 font-mono text-[10px] text-gray-400 shadow-2xl relative\">\n                            <div class=\"flex gap-1.5 mb-3\">\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-white/10\"></div>\n                                <div class=\"w-2.5 h-2.5 rounded-full bg-white