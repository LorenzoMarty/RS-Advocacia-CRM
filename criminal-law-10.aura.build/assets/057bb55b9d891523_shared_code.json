0 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center mb-6 text-brand-gold\">\n                                <span class=\"iconify\" data-icon=\"lucide:file-key\" data-width=\"20\"></span>\n                            </div>\n                            <h3 class=\"text-2xl font-medium text-white mb-3\">Habeas Corpus Imediato</h3>\n                            <p class=\"text-white/50 text-sm font-light leading-relaxed max-w-md\">\n                                Impetração de medidas liminares perante Tribunais Estaduais, STJ e STF. Atuamos com rapidez para reverter prisões ilegais e abusivas.\n                            </p>\n                        </div>\n                        \n                        <!-- Visual representation -->\n                        <div class=\"w-full h-24 md:h-32 relative border-t border-white/5 mt-4 pt-6\">\n                            <div class=\"flex justify-between items-center px-4 md:px-12\">\n                                <div class=\"flex flex-col items-center gap-2\">\n                                    <div class=\"w-8 h-8 rounded-full bg-white/10 border border-white/20 flex items-center justify-center\">\n                                        <span class=\"iconify text-white/40\" data-icon=\"lucide:lock\" data-width=\"14\"></span>\n                                    </div>\n                                    <div class=\"w-1 h-8 bg-gradient-to-b from-white/10 to-transparent\"></div>\n                                </div>\n                                <div class=\"flex-1 h-[1px] bg-gradient-to-r from-transparent via-brand-gold/50 to-transparent relative\">\n                                    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-2 h-2 bg-brand-gold rounded-full shadow-[0_0_10px_#D97706] animate-pulse\"></div>\n                                </div>\n                                <div class=\"flex flex-col items-center gap-2\">\n            