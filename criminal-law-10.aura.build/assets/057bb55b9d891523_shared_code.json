ite]\"></div>\n                            <div class=\"absolute inset-4 border border-brand-gold/10 rounded-full animate-[spin_15s_linear_infinite_reverse]\"></div>\n                            \n                            <div class=\"w-24 h-24 bg-brand-panel rounded-full border border-brand-gold/30 flex items-center justify-center shadow-[0_0_30px_rgba(217,119,6,0.2)] relative z-10\">\n                                <div class=\"w-16 h-16 bg-brand-gold rounded-full flex items-center justify-center\">\n                                    <span class=\"iconify text-white\" data-icon=\"lucide:scale\" data-width=\"32\"></span>\n                                </div>\n                            </div>\n                            \n                            <!-- Orbiting Particles -->\n                            <div class=\"absolute top-0 left-1/2 w-2 h-2 bg-brand-gold rounded-full shadow-[0_0_10px_#D97706]\"></div>\n                            <div class=\"absolute bottom-10 right-10 w-1.5 h-1.5 bg-brand-gold/50 rounded-full\"></div>\n                        </div>\n                        <p class=\"text-sm font-medium text-brand-gold uppercase tracking-widest\">Direito Restabelecido</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- CTA Section -->\n        <section class=\"container mx-auto px-6 max-w-4xl text-center mb-24 mt-24\">\n            <div class=\"glass-panel p-10 md:p-20 rounded-[3rem] border border-white/10 relative overflow-hidden reveal\">\n                <!-- Background Gradient -->\n                <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-gradient-to-b from-brand-gold/10 to-transparent pointer-events-none\"></div>\n                \n                <h2 class=\"text-3xl md:text-5xl font-serif text-white tracking-tight mb-6 relative z-10\">Sua liberdade não pode esperar.</h2>\n                <p class=\"text-base md:text-lg text-white/50 font-light mb-1